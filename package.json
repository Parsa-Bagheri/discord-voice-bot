{
  "name": "discord-voice-bot",
  "version": "1.0.0",
  "description": "Discord voice assistant: wake word + Gemini Live",
  "scripts": {
    "test": "tsx --test src/audio/resample.test.ts",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "models": "node scripts/download-models.mjs",
    "test:wake": "tsx scripts/test-wake.ts",
    "test:live": "tsx scripts/test-live.ts"
  },
  "keywords": [],
  "author": "Parsa Bagheri",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.17.0"
  },
  "dependencies": {
    "@discordjs/opus": "^0.11.0",
    "@discordjs/voice": "^0.19.2",
    "@google/genai": "^3.6.1",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.10",
    "sherpa-onnx-node": "^2.0.2",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "@discordjs/opus@0.11.0": true,
    "protobufjs@7.6.6": true,
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
