# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register slash commands to one guild for instant updates during development
DISCORD_DEV_GUILD_ID=

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-live
GEMINI_VOICE=Puck
ENABLE_GOOGLE_SEARCH=true
SYSTEM_PROMPT=You are Genius, a helpful, witty voice assistant in a Discord voice call. Keep answers short and conversational (1-3 sentences) unless asked for detail. The user may begin with the wake phrase "hey genius"; ignore it.

# Wake word (sherpa-onnx keyword spotting)
KWS_MODEL_DIR=models/sherpa-onnx-kws-zipformer-gigaspeech-3.3M-2024-01-01
KWS_KEYWORDS_FILE=config/keywords.txt
KWS_THRESHOLD=0.25
KWS_SCORE=1.5

# Conversation behaviour
FOLLOWUP_WINDOW_MS=8000
END_OF_SPEECH_MS=700
